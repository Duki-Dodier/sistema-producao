// MES – Fábrica de Engates | Schema da Fase 1
// Docs: https://pris.ly/d/prisma-schema
//
// PORTABILIDADE: o provider abaixo é "sqlite" só para desenvolvimento.
// No servidor da empresa, trocar para "postgresql" (uma linha) + a
// DATABASE_URL do Postgres. Por isso NÃO usamos enums nativos (o SQLite
// não suporta): campos como `tipo`, `curva` e `status` são String com os
// valores permitidos documentados em comentário e validados no código.

generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  runtime      = "cloudflare"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Setor de produção (Tubo, Plasma Tubo, Plasma Chapa, Componente,
/// Ponteira, Agrupamento, Solda, Pintura, Montagem).
model Setor {
  id              Int     @id @default(autoincrement())
  nome            String  @unique
  ordemPadrao     Int     @default(0) // ordem típica no fluxo, só para exibição
  metaMensal      Int? // meta de peças/mês do setor — usada no cockpit de Monitoramento
  mediaDiariaMeta Float? // média diária cadastrada para acompanhar o ritmo da meta
  lider           String? // líder do setor — exibido no cockpit de Monitoramento
  diasUteisMes    Int? // dias úteis do mês (override do cálculo seg–sex automático)

  roteiros                ModeloRoteiro[]
  apontamentos            Apontamento[]
  conferenciasPCP         ConferenciaPCP[]
  pecas                   Peca[]
  roteirosPeca            PecaRoteiro[]
  funcionarios            Funcionario[]
  recebimentosAgrupamento RecebimentoAgrupamento[]
  maquinas               Maquina[]
  producoesEmAndamento   ProducaoEmAndamento[]
  nestsCorte             NestCorte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Funcionário/operador de um setor — cadastrado em Configurações. Alimenta
/// as sugestões de soldador/abastecedor e, futuramente, escalas e metas
/// individuais.
model Funcionario {
  id            Int     @id @default(autoincrement())
  nome          String
  setorId       Int
  ativo         Boolean @default(true)
  pin           String? // PIN de 4 dígitos p/ apontar no kiosk e autorizar ajustes
  papel         String  @default("OPERADOR") // OPERADOR | LIDER | PCP
  usuario       String? @unique
  senhaHash     String?
  administrador Boolean @default(false)
  bancada       String? // bancada/box fixa do soldador, editável em Configurações

  setor               Setor                 @relation(fields: [setorId], references: [id], onDelete: Restrict)
  processosPermitidos FuncionarioProcesso[]
  apontamentos        Apontamento[]
  sessoes             OperadorSessao[]
  ajustesAutorizados  AjusteApontamento[]
  producoesEmAndamento ProducaoEmAndamento[]
  nestsProgramados     NestCorte[]       @relation("NestProgramador")
  eventosNest          NestEvento[]
  lancamentosNest      NestLancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, setorId])
  @@index([setorId])
}

model FuncionarioProcesso {
  id            Int    @id @default(autoincrement())
  funcionarioId Int
  processo      String

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, processo])
  @@index([processo])
}

/// Máquina/posto de produção disponível em um setor. Os códigos iniciais são
/// fictícios e podem ser trocados pelos nomes reais sem alterar os registros.
model Maquina {
  id       Int     @id @default(autoincrement())
  codigo   String
  nome     String
  setorId  Int
  ativo    Boolean @default(true)

  setor        Setor          @relation(fields: [setorId], references: [id], onDelete: Restrict)
  apontamentos Apontamento[]
  producoesEmAndamento ProducaoEmAndamento[]
  nestsCorte NestCorte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setorId, codigo])
  @@index([setorId, ativo])
}

model OperadorSessao {
  id            Int      @id @default(autoincrement())
  funcionarioId Int
  tokenHash     String   @unique
  expiraEm      DateTime
  createdAt     DateTime @default(now())

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([expiraEm])
}

/// Correção auditada de um apontamento: o valor original é atualizado no
/// próprio Apontamento, mas cada mudança fica registrada aqui — quem
/// autorizou (Líder do setor ou PCP, validado por PIN), quando e por quê.
model AjusteApontamento {
  id              Int      @id @default(autoincrement())
  apontamentoId   Int
  valorAnterior   Int
  valorNovo       Int
  motivo          String
  autorizadoPorId Int
  dataHora        DateTime @default(now())

  apontamento   Apontamento @relation(fields: [apontamentoId], references: [id], onDelete: Cascade)
  autorizadoPor Funcionario @relation(fields: [autorizadoPorId], references: [id], onDelete: Restrict)

  @@index([apontamentoId])
  @@index([autorizadoPorId])
}

/// Peça/SKU cadastrado (ex.: "Barra Chata 200mm", "Reforço 3mm"). Fabricada
/// em um setor específico. Vira uma linha da BOM (`ModeloPeca`) de um modelo.
model Peca {
  id        Int     @id @default(autoincrement())
  codigo    String  @unique
  nome      String
  medida    String? // texto livre p/ exibição, ex.: "200mm", "3/4mm" — NÃO usar p/ busca
  imagemUrl String? // foto da peça, ex.: "/api/uploads/AD1001/pecas/AD1001-PL1-xxx.jpg"
  setorId   Int // onde essa peça é fabricada

  // Campos estruturados p/ permitir buscar/filtrar/relacionar o mesmo material
  // entre peças e modelos diferentes (ex.: "todos os engates que usam tubo 50x50").
  tipoMaterial  String? // "TUBO" | "BARRA_CHATA" | "CHAPA" | "CANTONEIRA" | "REFORCO" | "PONTEIRA" | "OUTRO"
  medidaA       Float? // largura ou diâmetro (mm)
  medidaB       Float? // altura, só em seção retangular/quadrada (mm)
  espessuraMm   Float?
  comprimentoMm Float?
  processos     String? // roteiro interno ordenado: CORTE,FURACAO,DOBRA,CORTE_GRAU
  observacao    String? // impresso na ficha técnica da OP, ex.: "CORTE EM GRAU", "ITEM RETO"

  setor        Setor         @relation(fields: [setorId], references: [id], onDelete: Restrict)
  modelos      ModeloPeca[]
  apontamentos Apontamento[]
  producoesEmAndamento ProducaoEmAndamento[]
  roteiro      PecaRoteiro[]
  curvas       PecaCurva[]
  itensNest    NestItem[]
  configuracoesPonteiraComoTubo  ConfiguracaoPonteira[] @relation("PonteiraTubo")
  configuracoesPonteiraComoChapa ConfiguracaoPonteira[] @relation("PonteiraChapa")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setorId])
  @@index([tipoMaterial, medidaA, medidaB])
}

/// Define quais peças da BOM formam a ponteira de cada engate removível.
/// A identificação é necessária porque uma OP pode possuir várias chapas,
/// mas apenas uma delas pertence à ponteira.
model ConfiguracaoPonteira {
  id          Int @id @default(autoincrement())
  modeloId    Int @unique
  pecaTuboId  Int
  pecaChapaId Int

  modelo    Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  pecaTubo  Peca   @relation("PonteiraTubo", fields: [pecaTuboId], references: [id], onDelete: Restrict)
  pecaChapa Peca   @relation("PonteiraChapa", fields: [pecaChapaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pecaTuboId])
  @@index([pecaChapaId])
}

/// Histórico geral de alterações para rastreabilidade de cadastros e produção.
model HistoricoAlteracao {
  id          Int      @id @default(autoincrement())
  entidade    String   // MODELO | BOM | ROTEIRO | ESTOQUE | OP | NEST | FUNCIONARIO
  entidadeId  Int?
  acao        String   // CRIADO | ATUALIZADO | EXCLUIDO | MOVIMENTADO
  descricao   String
  usuario     String
  dadosAntes  String?
  dadosDepois String?
  dataHora    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([dataHora])
}

/// Saldo físico livre das ponteiras e dos componentes já cortados.
/// Os saldos são separados das OPs, que têm o próprio rastreamento de produção.
model EstoquePonteira {
  id               Int @id @default(autoincrement())
  tamanho          String @unique // PEQUENA | MEDIA | GRANDE
  quantidadePronta Int @default(0)
  tubosCortados    Int @default(0)
  chapasCortadas   Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Curva de dobra de uma peça (tabela "DOBRA" da folha do Tubo na OP
/// impressa): medida, ângulo e máquina de cada curva, na ordem de execução.
model PecaCurva {
  id          Int     @id @default(autoincrement())
  pecaId      Int
  ordem       Int // Curva 1, 2, 3...
  medidaCm    Float? // medida (cm) até a curva
  anguloGraus Float? // ângulo da dobra
  quantidade  Int     @default(1)
  maquina     String? // ex.: "CV1"

  peca Peca @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@unique([pecaId, ordem])
}

/// Confirma que o Agrupamento recebeu as peças fabricadas por um setor para
/// uma OP e registra onde o material foi guardado. Não altera a produção.
model RecebimentoAgrupamento {
  id            Int      @id @default(autoincrement())
  opId          Int
  setorOrigemId Int
  categoria     String // "SETOR:<id>" | "PONTEIRA" | "REFORCO"
  recebidoPor   String
  localizacao   String
  dataHora      DateTime @default(now())

  op          OP    @relation(fields: [opId], references: [id], onDelete: Cascade)
  setorOrigem Setor @relation(fields: [setorOrigemId], references: [id], onDelete: Restrict)

  @@unique([opId, categoria])
  @@index([setorOrigemId])
  @@index([dataHora])
}

/// Linha da BOM (lista de materiais) de um modelo: "cada engate do modelo X
/// usa N unidades da peça Y". Junto com OP.quantidade, dá a quantidade total
/// necessária dessa peça para fechar o kit da OP.
model ModeloPeca {
  id                   Int @id @default(autoincrement())
  modeloId             Int
  pecaId               Int
  quantidadeNecessaria Int @default(1) // quantas unidades da peça por engate

  modelo Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  peca   Peca   @relation(fields: [pecaId], references: [id], onDelete: Restrict)

  @@unique([modeloId, pecaId])
  @@index([pecaId])
}

/// Roteiro real de uma peça. Diferente do setor principal da peça, permite
/// que uma cantoneira seja cortada em Componentes, dobrada em Ponteira e então
/// liberada para o Agrupamento.
model PecaRoteiro {
  id       Int    @id @default(autoincrement())
  pecaId   Int
  setorId  Int
  processo String
  ordem    Int

  peca         Peca          @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  setor        Setor         @relation(fields: [setorId], references: [id], onDelete: Restrict)
  apontamentos Apontamento[]
  producoesEmAndamento ProducaoEmAndamento[]

  @@unique([pecaId, ordem])
  @@index([setorId])
  @@index([pecaId, setorId])
}

/// Modelo de engate. `roteiro` = por quais setores as peças desse modelo passam.
model Modelo {
  id              Int     @id @default(autoincrement())
  codigo          String  @unique
  nome            String? // nome comercial do engate
  curva           String // "A" | "B" | "C"
  tipo            String // "FIXO" | "REMOVIVEL" | "PONTEIRA_MACHO"
  tamanhoPonteira String? // PEQUENA | MEDIA | GRANDE — removíveis e ponteiras macho
  imagemUrl       String? // foto do engate, ex.: "/api/uploads/AD1001/modelo/AD1001-xxx.jpg"
  estoqueMinimo   Int? // estoque mínimo — alerta quando o estoque pronto cair abaixo disso
  regulador       Int? // legado: não é usado na operação; o valor vigente é estoqueMinimo
  linhaProduto    String  @default("BRUCKE") // "BRUCKE" | "REFORCEL"

  roteiro ModeloRoteiro[]
  ops     OP[]
  pecas   ModeloPeca[]
  configuracaoPonteira ConfiguracaoPonteira?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma etapa do roteiro de um modelo: "o modelo X passa pelo setor Y na ordem N".
/// O conjunto de linhas de um modelo define o roteiro configurável dele.
model ModeloRoteiro {
  id       Int @id @default(autoincrement())
  modeloId Int
  setorId  Int
  ordem    Int // posição do setor no roteiro do modelo (1, 2, 3...)

  modelo Modelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  setor  Setor  @relation(fields: [setorId], references: [id], onDelete: Restrict)

  @@unique([modeloId, setorId]) // um setor aparece no máximo uma vez por modelo
  @@unique([modeloId, ordem]) // ordem única dentro do roteiro do modelo
  @@index([setorId])
}

/// Ordem de Produção. A OP também é o lote. `numeroSequencia` (0–1000) é a
/// prioridade de liberação, a mesma em todos os setores.
model OP {
  id              Int       @id @default(autoincrement())
  numeroSequencia Int // 0–1000, prioridade de liberação
  lote            String?   @unique // lote único p/ rastreabilidade
  modeloId        Int
  quantidade      Int
  status          String    @default("ABERTA") // "ABERTA" | "CONCLUIDA" | "CANCELADA"
  dataLiberacao   DateTime  @default(now())
  dataFinalizacao DateTime? // preenchida automaticamente ao marcar a OP como CONCLUIDA
  previsaoEntrega DateTime? // impressa na capa do documento da OP

  modelo                  Modelo                   @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  apontamentos            Apontamento[]
  recebimentosAgrupamento RecebimentoAgrupamento[]
  entradasEstoque         EntradaEstoque[]
  producoesEmAndamento    ProducaoEmAndamento[]
  itensNest               NestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modeloId])
  @@index([numeroSequencia])
}

/// Fechamento diário da cabine de Pintura. A Pintura informa somente o total
/// das duas linhas da empresa; a distribuição por OP acontece na liberação
/// detalhada para a Montagem.
model FechamentoPintura {
  id                 Int      @id @default(autoincrement())
  data               DateTime @unique
  quantidadeBrucke   Int      @default(0)
  quantidadeReforcel Int      @default(0)
  refugoBrucke       Int      @default(0)
  refugoReforcel     Int      @default(0)
  usuario            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Entrada parcial de produto acabado no estoque. Uma OP pode gerar várias
/// entradas até atingir sua quantidade total.
model EntradaEstoque {
  id         Int      @id @default(autoincrement())
  opId       Int
  quantidade Int
  usuario    String
  dataHora   DateTime @default(now())

  op OP @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@index([opId])
  @@index([dataHora])
}

/// Apontamento de produção: "na OP X, no setor Y, o líder produziu N boas / M refugo".
/// É por OP+setor (quantidade), não por peça individual.
model Apontamento {
  id                Int      @id @default(autoincrement())
  opId              Int
  setorId           Int
  funcionarioId     Int?
  usuario           String // líder do setor que lançou
  quantidadeBoa     Int      @default(0)
  quantidadeRefugo  Int      @default(0)
  dataHora          DateTime @default(now())
  soldador          String? // só usado em apontamentos do setor Solda
  bancada           String? // ex.: "BOX 22" — só usado em apontamentos do setor Solda
  abastecedor       String? // quem abasteceu a bancada — só usado em apontamentos do setor Solda
  quantidadeSoldada Int      @default(0) // nos envios de Solda: quanto do abastecido já foi soldado de fato
  pecaId            Int? // se o setor tem peças (BOM) cadastradas, aponta para qual peça
  processo          String? // CORTE | FURACAO | DOBRA | CORTE_GRAU
  roteiroEtapaId    Int? // etapa exata do roteiro entre setores
  origem            String   @default("OPERADOR") // OPERADOR | LEGADO
  maquinaId         Int? // máquina/posto usado no apontamento
  tempoSegundos     Int? // tempo efetivo informado pelo operador/monitor
  inicioEm          DateTime? // início estimado do ciclo; dataHora é o fim

  op           OP                  @relation(fields: [opId], references: [id], onDelete: Cascade)
  setor        Setor               @relation(fields: [setorId], references: [id], onDelete: Restrict)
  funcionario  Funcionario?        @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)
  peca         Peca?               @relation(fields: [pecaId], references: [id], onDelete: SetNull)
  roteiroEtapa PecaRoteiro?        @relation(fields: [roteiroEtapaId], references: [id], onDelete: SetNull)
  maquina      Maquina?             @relation(fields: [maquinaId], references: [id], onDelete: SetNull)
  ajustes      AjusteApontamento[]
  lancamentoNest NestLancamento?

  @@index([opId])
  @@index([setorId])
  @@index([funcionarioId])
  @@index([pecaId])
  @@index([roteiroEtapaId])
  @@index([maquinaId])
  @@index([setorId, dataHora, origem])
}

/// Programação de corte criada no Libellula (ou equivalente). Um nest pode
/// aproveitar uma única chapa para atender peças de diversas OPs.
model NestCorte {
  id                    Int      @id @default(autoincrement())
  codigo                String   @unique // Ex.: NEST3530
  nomeArquivo           String?
  arquivoPdfUrl         String?  // PDF de agrupamento exportado pelo Libellula
  setorId               Int
  maquinaId             Int
  programadorId         Int
  material              String   @default("Aço")
  espessuraMm           Float?
  larguraChapaMm        Float?
  alturaChapaMm         Float?
  pesoChapaKg           Float?
  pesoPecasKg           Float?
  pesoSobraKg           Float?
  aproveitamentoPct     Float?
  quantidadeChapas      Int      @default(1)
  numeroPiercings       Int?
  comprimentoCorteMm    Float?
  comprimentoRapidoMm   Float?
  tempoCorteSegundos    Int?
  tempoDeslocamentoSegundos Int?
  status                String   @default("PROGRAMADO") // PROGRAMADO | EM_CORTE | PAUSADO | CONCLUIDO | CANCELADO
  iniciadoEm            DateTime?
  finalizadoEm          DateTime?
  refeitoDeId           Int? // NEST original que originou esta nova programação
  observacao            String?

  setor       Setor       @relation(fields: [setorId], references: [id], onDelete: Restrict)
  maquina     Maquina     @relation(fields: [maquinaId], references: [id], onDelete: Restrict)
  programador Funcionario @relation("NestProgramador", fields: [programadorId], references: [id], onDelete: Restrict)
  itens       NestItem[]
  eventos     NestEvento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setorId, status])
  @@index([maquinaId, createdAt])
  @@index([programadorId, createdAt])
}

/// Peça planejada dentro de um nest, vinculada à OP que ela deve atender.
model NestItem {
  id                   Int @id @default(autoincrement())
  nestId               Int
  opId                 Int
  pecaId               Int
  quantidadePlanejada  Int

  nest        NestCorte       @relation(fields: [nestId], references: [id], onDelete: Cascade)
  op          OP              @relation(fields: [opId], references: [id], onDelete: Restrict)
  peca        Peca            @relation(fields: [pecaId], references: [id], onDelete: Restrict)
  lancamentos NestLancamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nestId, opId, pecaId])
  @@index([opId, pecaId])
}

/// Linha de tempo operacional do nest: início, pausa, retorno, conclusão e
/// cancelamento. Preserva a rastreabilidade mesmo sem apontar peças.
model NestEvento {
  id            Int      @id @default(autoincrement())
  nestId        Int
  funcionarioId Int
  tipo          String   // PROGRAMADO | INICIO | PAUSA | RETORNO | FIM | CANCELAMENTO
  descricao     String?
  dataHora      DateTime @default(now())

  nest        NestCorte   @relation(fields: [nestId], references: [id], onDelete: Cascade)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)

  @@index([nestId, dataHora])
  @@index([funcionarioId, dataHora])
}

/// Baixa por peça cortada no nest. A baixa também gera um Apontamento normal,
/// mantendo os painéis e a rastreabilidade por OP sincronizados.
model NestLancamento {
  id               Int      @id @default(autoincrement())
  nestItemId       Int
  funcionarioId    Int
  apontamentoId    Int?     @unique
  tipo             String   @default("PRODUCAO") // PRODUCAO | RETRABALHO
  quantidadeBoa    Int      @default(0)
  quantidadeRefugo Int      @default(0)
  motivoRefugo     String?
  observacao       String?
  dataHora         DateTime @default(now())

  item        NestItem    @relation(fields: [nestItemId], references: [id], onDelete: Cascade)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  apontamento Apontamento? @relation(fields: [apontamentoId], references: [id], onDelete: SetNull)

  @@index([nestItemId, dataHora])
  @@index([funcionarioId, dataHora])
}

/// Ciclo iniciado pelo operador e finalizado somente quando a produção foi
/// concluída. A linha vira um Apontamento no encerramento, preservando o
/// horário real de início e o tempo efetivo do processo.
model ProducaoEmAndamento {
  id              Int      @id @default(autoincrement())
  opId            Int
  setorId         Int
  funcionarioId   Int
  pecaId          Int?
  roteiroEtapaId  Int?
  processo        String?
  maquinaId       Int
  usuario         String
  iniciadoEm      DateTime @default(now())
  quantidadePrevista Int?

  op           OP                  @relation(fields: [opId], references: [id], onDelete: Cascade)
  setor        Setor               @relation(fields: [setorId], references: [id], onDelete: Restrict)
  funcionario  Funcionario         @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  peca         Peca?               @relation(fields: [pecaId], references: [id], onDelete: SetNull)
  roteiroEtapa PecaRoteiro?        @relation(fields: [roteiroEtapaId], references: [id], onDelete: SetNull)
  maquina      Maquina             @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funcionarioId, iniciadoEm])
  @@index([setorId, iniciadoEm])
  @@index([opId])
}

/// Fechamento diario informado pelo PCP. O total conferido nao substitui nem
/// apaga os apontamentos do operador: ele e usado para reconciliacao e para o
/// numero oficial dos paineis depois da conferencia.
model ConferenciaPCP {
  id             Int      @id @default(autoincrement())
  setorId        Int
  data           DateTime
  usuario        String
  totalConferido Int
  observacao     String?

  setor Setor                @relation(fields: [setorId], references: [id], onDelete: Restrict)
  itens ConferenciaPCPItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setorId, data])
  @@index([data])
}

/// Detalhamento livre por categoria, permitindo reproduzir as tabelas usadas
/// hoje por Tubo, Plasma, Componentes/Acessorios e Ponteira sem engessar o banco.
model ConferenciaPCPItem {
  id            Int    @id @default(autoincrement())
  conferenciaId Int
  categoria     String
  quantidade    Int    @default(0)

  conferencia ConferenciaPCP @relation(fields: [conferenciaId], references: [id], onDelete: Cascade)

  @@unique([conferenciaId, categoria])
  @@index([conferenciaId])
}

