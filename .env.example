# Copie para `.env` e ajuste conforme o ambiente.

# --- Desenvolvimento (SQLite, sem instalar nada) ---
DATABASE_URL="file:./dev.db"

# --- Produção no servidor da empresa (Postgres) ---
# Ao migrar: em prisma/schema.prisma troque `provider = "sqlite"` por
# `provider = "postgresql"`, rode `prisma migrate dev`, e use algo como:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/mes_engates?schema=public"
